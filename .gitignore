# Generated harness wiring (regenerate with `aef dev` for framework development,
# or `aef init` in a consumer). Anchored to repo root so examples/consumer/ stays tracked.
# Only the skills/ subdirs are ignored — settings files (settings.json, etc.) are tracked.
/.claude/skills/
/.codex/skills/
/.cursor/skills/

node_modules/

# Build + test artifacts
dist/
coverage/
*.tsbuildinfo

# Throwaway package.json backup from scripts/snapshot.sh (restored on exit;
# ignored in case a publish is hard-killed mid-run).
.package.json.snapshot-bak
