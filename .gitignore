# Harness dirs: track only committed settings/hooks files; ignore everything else
# (generated skills/, machine-written mcp.json, user-local overrides, etc.).
# Anchored to repo root so examples/consumer/ stays tracked.
/.claude/*
!/.claude/settings.json
/.codex/*
!/.codex/hooks.json
/.cursor/*
!/.cursor/hooks.json

node_modules/

# Build + test artifacts
dist/
coverage/
*.tsbuildinfo

# Throwaway package.json backup from scripts/snapshot.sh (restored on exit;
# ignored in case a publish is hard-killed mid-run).
.package.json.snapshot-bak
