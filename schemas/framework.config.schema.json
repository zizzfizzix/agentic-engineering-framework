{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zizzfizzix/agentic-engineering-framework/schemas/framework.config.schema.json",
  "title": "framework.config.json",
  "description": "Per-consumer configuration the renderer, install-skills, and skills all read. One axis selection per family; init resolves these into a converged skill set.",
  "type": "object",
  "required": ["harnesses"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "projectName": { "type": "string", "description": "Substituted for {{PROJECT_NAME}} in templates." },
    "harnesses": {
      "type": "array",
      "description": "Active harness adapters; each wires its files + skills dir.",
      "items": { "type": "string", "examples": ["claude-code", "codex", "cursor"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "orm": { "type": ["string", "null"], "description": "Selected ORM adapter, or null to omit ORM skills.", "examples": ["drizzle", "mikro-orm", "prisma", "typeorm"] },
    "ui": { "type": ["string", "null"], "examples": ["open-mercato-ui", "shadcn", "mui"] },
    "stack": { "type": ["string", "null"], "examples": ["generic-node", "next-monorepo"] },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modulesRoot": { "type": "string" },
        "specsRoot": { "type": "string" },
        "testsRoot": { "type": "string" }
      }
    },
    "validation": {
      "type": "array",
      "description": "Commands skills run as the verification gate.",
      "items": { "type": "string" }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultBranch": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "description": "Where improve-framework finds the framework SOURCE (decisions #7/#8).",
      "additionalProperties": false,
      "properties": {
        "path": { "type": ["string", "null"], "description": "Local checkout path; if null, clone repo on demand." },
        "repo": { "type": ["string", "null"] }
      }
    },
    "feedback": {
      "type": "object",
      "description": "Cross-repo self-improving loop (decision #8). Off by default.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "channel": { "type": "string", "enum": ["pr", "issue", "fork"], "default": "issue" },
        "sanitize": { "type": "boolean", "default": true }
      }
    }
  }
}
